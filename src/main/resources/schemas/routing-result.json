{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes", "clarificationRequired"],
  "properties": {
    "routes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "segment", "confidence", "reason"],
        "properties": {
          "agentId": {"type": "string"},
          "segment": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    },
    "clarificationRequired": {"type": "boolean"},
    "clarificationQuestion": {"type": ["string", "null"]}
  }
}
